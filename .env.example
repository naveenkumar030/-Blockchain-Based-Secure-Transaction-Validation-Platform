# MongoDB Connection URI (used by Backend)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority

# JWT Token Secret (used by Backend for session signing)
JWT_SECRET=your_jwt_secret_key_here

# Gmail SMTP Email Credentials (used by Backend for OTP emails)
EMAIL_USER=your_smtp_email_username@gmail.com
EMAIL_PASS=your_smtp_app_specific_password

# Neo4j Connection Credentials (used by Backend for graph visualizations)
NEO4J_URI=neo4j+s://<aura-db-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_database_password
NEO4J_DATABASE=neo4j

# AWS S3 Storage Credentials (Optional, falls back to local disk if blank)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name

# Login Session Lifetime (in minutes; defaults to 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

